generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  SUSPENDED
  EXPIRED
  PENDING
}

enum Role {
  ADMIN
  MEMBER
}

enum ToolStatus {
  IN_DEVELOPMENT
  AVAILABLE
}

enum ToolCategory {
  SHOPIFY_THEMES
  SHOPIFY_APPS
  MARKETING
  OTHER
}

enum ProjectStatus {
  IN_PROGRESS
  COMPLETED
}

enum QuoteRequestStatus {
  PENDING
  QUOTED
  ACCEPTED
  DECLINED
  FAILED
}

enum QuoteRequestKind {
  TOOL
  PROJECT
  CUSTOM
}

enum CommentAuthorType {
  MEMBER
  ADMIN
  SYSTEM
}

enum PipelineStage {
  NEW
  QUOTED
  NEGOTIATING
  WON
  LOST
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(MEMBER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  currentSessionId String?
  lastLoginAt      DateTime?
  lastLoginIp      String?

  accounts             Account[]
  sessions             Session[]
  subscription         Subscription?
  license              License?
  toolDownloads        ToolDownload[]
  quoteRequests        QuoteRequest[]
  comments             Comment[]
  notes                Note[]
  deliverablesUploaded Deliverable[]
  toolUsages           ToolUsage[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  paypalSubscriptionId String             @unique
  paypalPlanId         String
  status               SubscriptionStatus @default(PENDING)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model License {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String    @unique
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

model Tool {
  id                 String       @id @default(cuid())
  slug               String       @unique
  name               String
  tagline            String?
  desc               String       @db.Text
  imageUrl           String?
  screenshots        String[]     @default([])
  tags               String[]     @default([])
  featured           Boolean      @default(false)
  version            String?
  status             ToolStatus   @default(IN_DEVELOPMENT)
  category           ToolCategory @default(OTHER)
  guideUrl           String?
  downloadUrl        String?
  downloadCount      Int          @default(0)
  requiresLicenseKey Boolean      @default(false)
  enabled            Boolean      @default(true)
  order              Int          @default(0)
  usageQuota         Int?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  downloads     ToolDownload[]
  apiKeys       ToolApiKey[]
  quoteRequests QuoteRequest[]
  usages        ToolUsage[]
}

/// API key issued to a tool so its (possibly external) backend can call
/// POST /api/license/verify to check a subscriber's license key.
model ToolApiKey {
  id         String    @id @default(cuid())
  toolId     String
  tool       Tool      @relation(fields: [toolId], references: [id], onDelete: Cascade)
  name       String?
  keyHash    String    @unique
  keyPrefix  String
  active     Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@index([toolId])
}

model ToolDownload {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolId           String
  tool             Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  count            Int      @default(0)
  lastDownloadedAt DateTime @default(now())
  createdAt        DateTime @default(now())

  @@unique([userId, toolId])
}

model Project {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  tagline     String?
  desc        String        @db.Text
  imageUrl    String?
  screenshots String[]      @default([])
  tags        String[]      @default([])
  featured    Boolean       @default(false)
  status      ProjectStatus @default(IN_PROGRESS)
  liveUrl     String?
  repoUrl     String?
  enabled     Boolean       @default(true)
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  quoteRequests QuoteRequest[]
}

model QuoteRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind      QuoteRequestKind
  toolId    String?
  tool      Tool?            @relation(fields: [toolId], references: [id], onDelete: SetNull)
  projectId String?
  project   Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)

  title       String
  description String @db.Text

  status QuoteRequestStatus @default(PENDING)

  quoteSummary      String?   @db.Text
  quoteScope        Json?
  quoteTimeline     String?   @db.Text
  quoteEstimate     String?
  quoteRaw          String?   @db.Text
  quotedAt          DateTime?
  regenerationCount Int       @default(0)

  errorMessage String? @db.Text

  pipelineStage PipelineStage @default(NEW)
  followUpAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments     Comment[]
  notes        Note[]
  deliverables Deliverable[]
  invoice      Invoice?

  @@index([userId])
  @@index([status])
  @@index([pipelineStage])
}

model Comment {
  id             String            @id @default(cuid())
  quoteRequestId String
  quoteRequest   QuoteRequest      @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  authorId       String?
  author         User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorType     CommentAuthorType
  body           String            @db.Text
  attachmentUrl  String?
  createdAt      DateTime          @default(now())

  @@index([quoteRequestId])
}

model Note {
  id             String       @id @default(cuid())
  quoteRequestId String
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body           String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([quoteRequestId])
}

model Invoice {
  id             String        @id @default(cuid())
  quoteRequestId String        @unique
  quoteRequest   QuoteRequest  @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  paypalOrderId  String?       @unique
  totalAmount    Int
  depositAmount  Int?
  depositPaid    Boolean       @default(false)
  balancePaid    Boolean       @default(false)
  currency       String        @default("USD")
  status         InvoiceStatus @default(DRAFT)
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Deliverable {
  id             String       @id @default(cuid())
  quoteRequestId String
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  name           String
  fileUrl        String
  fileSize       Int?
  uploadedById   String
  uploadedBy     User         @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([quoteRequestId])
}

model ToolUsage {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolId      String
  tool        Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  periodStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([userId, toolId, periodStart])
}
